{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enform.dev/schemas/flow/v1.json",
  "title": "enform flow definition",
  "description": "One flow definition document, version 1 (MVP.md DF-1, DF-4, I9). A flow is one JSON document with an integer schemaVersion. The optional anonymous setting is ID-3 and the optional fields of a step are FM-1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "anonymous": { "type": "boolean" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "targets"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        },
        "fields": {
          "description": "The form fields that the step shows (FM-1).",
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outcomes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skipWhen": { "$ref": "#/$defs/jsonLogic" }
      }
    },
    "field": {
      "description": "One form field: a key, one of the sixteen controls (FM-1), and the option list of a choice control.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "control"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "control": { "$ref": "#/$defs/control" },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "control": {
      "description": "The sixteen form controls of FM-1.",
      "enum": [
        "text",
        "long-text",
        "number",
        "money",
        "date",
        "select",
        "multi-select",
        "checkbox",
        "radio",
        "yes-no",
        "email",
        "phone",
        "file",
        "user",
        "static",
        "repeating"
      ]
    },
    "target": {
      "description": "A task recipient: exactly one kind, per AS-1. Dynamic targets are starter, field and manager-of.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "user": { "type": "string" },
        "group": { "type": "string" },
        "team": { "type": "string" },
        "field": { "type": "string" },
        "starter": { "type": "string" },
        "manager-of": { "type": "string" }
      }
    },
    "jsonLogic": {
      "description": "A JSON Logic expression tree (FM-5, ADR 0008).",
      "type": ["object", "array", "string", "number", "boolean", "null"]
    }
  }
}
